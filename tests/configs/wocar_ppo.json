    "pretrained_critic_net": "tests/models/ppo_critic",
    "pretrained_net": "tests/models/ppo",
    "ppo_actor_update_steps": 10,
    "ppo_critic_update_steps": 10,
    "ppo_update_epochs": 10,
    "ppo_clip_epsilon": 0.2,
    "ppo_lm": 0.8,
    "ppo_nworkers": 8,
    "ppo_minibatch_size": 64,
    "ppo_continuous": false,
    "k_wst": 0.5,
    "k_reg": 0.02,
