{
    "env_name": "highway-fast-v0",
    "env_config": {
        "lanes_count": 4,
        "vehicles_count": 40,
        "duration": 30,
        "ego_spacing": 2,
        "vehicles_density": 1.1,
        "collision_reward": -5,
        "right_lane_reward": 0.0,
        "high_speed_reward": 1.0,
        "lane_change_reward": 0.02,
        "reward_speed_range": [
            25,
            40
        ],
        "normalize_reward": true,
        "simulation_frequency": 15,
        "policy_frequency": 5
    },
    "seed": 123123,
    "parallel": true,
    "gamma": 0.99,
    "buffer_size": 2048,
    "iterations": 200,
    "learning_rate": 0.0005,
    "max_grad_norm": 0.5,
    "ent_coef": 0.0,
    "policy_kwargs": {
        "net_arch": [
            256,
            256
        ]
    },
    "pretrained_critic_net": "tests/models/ppo_continuous_critic",
    "pretrained_net": "tests/models/ppo_continuous",
    "ppo_actor_update_steps": 10,
    "ppo_critic_update_steps": 10,
    "ppo_update_epochs": 10,
    "woca_update_epochs": 4,
    "woca_baseline_samples": 64,
    "ppo_clip_epsilon": 0.2,
    "ppo_lm": 0.8,
    "ppo_nworkers": 8,
    "ppo_minibatch_size": 64,
    "ppo_continuous": true,
    "k_wst": 0.5,
    "k_wst_start": 0.0,
    "k_wst_frac": 0.8,
    "k_reg": 0.2,
    "attack_budget": 0.05,
    "attack_budget_start": 0.0,
    "attack_budget_frac": 0.8,
    "wocar_grad_step_size": 5e-4,
    "wocar_grad_steps": 50,
    "log_freq": 20
}
